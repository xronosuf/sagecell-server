# syntax=docker/dockerfile:1

# EXPERIMENTAL compatibility path.
#
# This intentionally tracks the latest STABLE SageMath container image.
# "experimental" refers to this repository's unvalidated compatibility with
# that moving SageMath target; it does NOT mean a SageMath development build.
# Users who intentionally want SageMath develop must override SAGEMATH_IMAGE
# themselves and should expect to debug compatibility failures.
ARG SAGEMATH_IMAGE=docker.io/sagemath/sagemath:latest
FROM ${SAGEMATH_IMAGE}

USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Keep SageCell source pinned while probing a newer SageMath environment so
# failures are easier to attribute to the SageMath/dependency change.
ARG SAGECELL_GIT_REF=281fc2356c52929fb08f4cd4cbfd8655e4ddd236

ENV DEBIAN_FRONTEND=noninteractive \
    SAGECELL_HOME=/opt/sagecell \
    SAGECELL_PORT=8888 \
    SAGECELL_GIT_REF=${SAGECELL_GIT_REF} \
    SAGECELL_WORKDIR=/tmp/sagecell \
    SAGECELL_DB=/var/lib/sagecell/sqlite.db \
    SAGECELL_MAX_KERNELS=4 \
    SAGECELL_MAX_PREFORKED=1 \
    SAGECELL_RLIMIT_CPU=30 \
    PYTHONUNBUFFERED=1

# Use the same package NAMES as the reviewed build, but intentionally do not
# request the reviewed exact versions. This is the moving compatibility probe.
COPY packages-known-good.txt /tmp/packages-known-good.txt
RUN apt-get update \
    && grep -vE '^[[:space:]]*(#|$)' /tmp/packages-known-good.txt \
       | sed 's/=.*$//' \
       | xargs apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p "$SAGECELL_WORKDIR" /var/lib/sagecell

WORKDIR /opt
RUN git clone https://github.com/sagemath/sagecell.git "${SAGECELL_HOME}" \
    && git -C "${SAGECELL_HOME}" checkout --detach "${SAGECELL_GIT_REF}" \
    && test "$(git -C "${SAGECELL_HOME}" rev-parse HEAD)" = "${SAGECELL_GIT_REF}"

WORKDIR ${SAGECELL_HOME}

# Install the direct SageCell additions without the reviewed frozen constraint
# set. The resulting environment MUST be treated as unvalidated until the
# image builds and the smoke test succeeds.
RUN sage -pip install --no-cache-dir \
        lockfile \
        paramiko \
        psutil \
        sockjs-tornado \
        SQLAlchemy

COPY patch_sagecell.py /tmp/patch_sagecell.py
RUN python3 /tmp/patch_sagecell.py

COPY sagecell_config.py /opt/sagecell/config.py
COPY sagecell_log.py /opt/sagecell/log.py

RUN mkdir -p static build

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /usr/local/bin/healthcheck.sh

EXPOSE 8888
VOLUME ["/var/lib/sagecell"]

HEALTHCHECK --interval=30s --timeout=45s --start-period=240s --retries=5 \
    CMD /usr/local/bin/healthcheck.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["sagecell"]
